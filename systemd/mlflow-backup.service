# Nightly copy of the MLflow DB to /var/backups/mlflow (keeps 7). Started by mlflow-backup.timer.
[Unit]
Description=hawk: back up the MLflow DB
RequiresMountsFor=/var/lib/mlflow
OnFailure=hawk-notify@%N.service

[Service]
Type=oneshot
User=mlflow
Group=mlflow
ExecStart=/opt/hawk/bin/hawk mlflow-backup
ProtectSystem=strict
ReadWritePaths=/var/backups/mlflow
ProtectHome=true
PrivateTmp=true
